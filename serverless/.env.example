# Names only. Real values go in Vercel → Settings → Environment Variables.

# Data: "demo" (in-memory synthetic data, the default) or "supabase"
DATA_SOURCE=demo
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never sent to a browser

# AI triage (Gemini). Without a key, complaints are triaged by keyword rules and flagged for review.
GEMINI_API_KEY=
GEMINI_MODEL=                       # optional, default gemini-3.6-flash

# Email (Gmail SMTP app password). Without these, emails are logged instead of sent.
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_FROM=                          # optional, defaults to SMTP_USER

# Voice agent (Retell). Required for the voice endpoints: requests must carry a valid Retell signature.
RETELL_API_KEY=
RETELL_AGENT_ID=                    # the agent the browser "Start call" button connects to
WEB_CALL_PASSCODE=                  # optional: visitors must enter this code to start a call
WEB_CALL_MAX_PER_IP=                # optional, default 3 calls per IP per 10 minutes
WEB_CALL_MAX_PER_HOUR=              # optional, default 30 calls per hour overall
CRON_SECRET=                        # token the hourly GitHub Action sends to /api/sla-sweep (deadline monitor)
SUMMARY_SECRET=                     # optional: signs after-call summary links (defaults to one derived from RETELL_API_KEY)

# Access
ALLOWED_ORIGINS=                    # comma-separated origins allowed to submit complaints from a browser
ADMIN_API_KEY=                      # required for GET /api/complaints-summary (returns patient data)
ALERT_EMAIL_OVERRIDE=               # optional demo setting: send every department alert to this inbox
